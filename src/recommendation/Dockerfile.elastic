FROM docker.io/library/python:3.14.6-alpine3.23@sha256:b165067c5afc37fa5608a3c05609cc3d51aafd808a30fbfd822ee594fef55ad4 AS build-venv

RUN apk update && \
    apk add gcc g++ linux-headers

ARG ELASTIC_OTEL_PYTHON_VERSION=1.17.0

COPY ./src/recommendation/requirements.txt requirements.txt

RUN python -m venv venv && \
    venv/bin/pip install --no-cache-dir --require-hashes -r requirements.txt

# Install the Elastic Distribution of OpenTelemetry Python. This is a
# replacement for the community opentelemetry-distro, not an addition:
# both packages register entry points under the same `distro`/`configurator`
# names, so having both installed makes which one `opentelemetry-instrument`
# picks non-deterministic. The uninstall must happen first, and edot-bootstrap
# (replacing opentelemetry-bootstrap) must run after the version upgrade, since
# it reads the instrumentor list from the currently installed
# opentelemetry-instrumentation package. See
# https://github.com/elastic/elastic-otel-python releases. The pip check and
# entry-point assertion turn a silently half-instrumented image (pip uninstall
# of an absent package, or a swallowed instrumentor install failure) into a
# build failure instead.
RUN venv/bin/pip uninstall -y opentelemetry-distro && \
    venv/bin/pip install --no-cache-dir elastic-opentelemetry==${ELASTIC_OTEL_PYTHON_VERSION} && \
    venv/bin/edot-bootstrap -a install && \
    venv/bin/pip check && \
    venv/bin/python -c "from importlib.metadata import entry_points; \
      [__import__('sys').exit(f'unexpected {g} providers: {e}') \
       for g in ('opentelemetry_distro', 'opentelemetry_configurator') \
       for e in [list(entry_points(group=g))] \
       if len(e) != 1 or not e[0].value.startswith('elasticotel')]"

FROM docker.io/library/python:3.14.6-alpine3.23@sha256:b165067c5afc37fa5608a3c05609cc3d51aafd808a30fbfd822ee594fef55ad4

COPY --from=build-venv /venv/ /venv/

WORKDIR /app

COPY ./src/recommendation/demo_pb2_grpc.py demo_pb2_grpc.py
COPY ./src/recommendation/demo_pb2.py demo_pb2.py
COPY ./src/recommendation/logger.py logger.py
COPY ./src/recommendation/metrics.py metrics.py
COPY ./src/recommendation/recommendation_server.py recommendation_server.py

# Off k8s/Lambda/Cloud Run, EDOT's distro defaults to also probing GCP/AWS/Azure
# cloud metadata endpoints, which only fail slowly in plain Docker. Pin to
# EDOT's own base detectors plus the generic `otel` one (OTEL_RESOURCE_ATTRIBUTES/
# OTEL_SERVICE_NAME), matching the only environment this demo runs in.
ENV OTEL_EXPERIMENTAL_RESOURCE_DETECTORS=process_runtime,os,telemetry_distro,service_instance,containerid,otel

EXPOSE ${RECOMMENDATION_PORT}
ENTRYPOINT [ "/venv/bin/opentelemetry-instrument", "/venv/bin/python", "recommendation_server.py" ]
